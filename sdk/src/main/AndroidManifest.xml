<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No supportsRtl here: a library value would fight a host that sets
         false. The Arabic wall mirrors when the host declares
         android:supportsRtl="true" (see README). -->
    <application>
        <activity
            android:name="com.playndgain.sdk.ui.PlayndgainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|locale|layoutDirection"
            android:exported="false"
            android:theme="@style/Playndgain.Theme" />
    </application>
</manifest>
