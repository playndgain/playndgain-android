# ---------------------------------------------------------------------------
# PLAYNDGAIN — the Dokploy environment.
# ---------------------------------------------------------------------------
#
# Paste this into the Dokploy Compose application's Environment tab and fill in
# the blanks. Dokploy writes it to a .env file beside docker-compose.yml, and
# the `env_file:` line in that file is what puts these into the containers.
#
# Deploy as Compose Type = Stack with Advanced → Command:
#   sh docker/dokploy-stack-deploy.sh <dokploy-compose-appName>
# and enable AutoDeploy on main (docs/13-dokploy.md §2.2).
#
# This is NOT .env.example. That file documents local development, where the
# defaults are a MySQL on 127.0.0.1 and a Mailpit on :1025. Read it for the
# meaning of the PLAYNDGAIN_* keys — the comments there are the reference and
# are not repeated here.
#
# Nothing below is baked into the image. The image carries no environment file
# at all, so a variable you leave out falls back to the framework's default,
# not to a local development value.

# --- Identity --------------------------------------------------------------

APP_NAME=PLAYNDGAIN
APP_ENV=production

# Generate ONCE, on your machine, with:  php artisan key:generate --show
# Then keep it forever. Every encrypted column — network credentials, publisher
# payout details, app secret keys — is unreadable under a different key, and a
# database restored without it is a database of ciphertext. It belongs in your
# password manager alongside the database credentials.
APP_KEY=

# The container refuses to start if this is true while APP_ENV=production.
APP_DEBUG=false

APP_URL=https://playndgain.com

# --- Domains ---------------------------------------------------------------
#
# The three server_name values, rendered into the nginx blocks at container
# start. They must match the domains you add to the `app` service in Dokploy,
# or requests arrive on a name no block claims and fall through to the site
# block — which would serve the wall with framing protection ON, breaking every
# publisher's iframe.

APP_DOMAIN=playndgain.com
WALL_DOMAIN=wall.playndgain.com
API_DOMAIN=api.playndgain.com

# --- Logging ---------------------------------------------------------------
#
# stderr, not the `stack`/`single` pair .env.example uses: Dokploy reads
# container logs, and a file under storage/logs is invisible from the panel and
# grows until it is the reason the disk fills.

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- Database — the Dokploy MySQL service ----------------------------------
#
# DB_HOST is that service's container name as Dokploy shows it, not an IP and
# not localhost. Both services must sit on dokploy-network; docker-compose.yml
# puts this application there already.

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=playndgain
DB_USERNAME=
DB_PASSWORD=

# --- Redis — the Dokploy Redis service -------------------------------------

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail ------------------------------------------------------------------
#
# Mailgun's HTTP API rather than SMTP: the domain must be verified and the from
# address must be on it. EU accounts use api.eu.mailgun.net.

MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS=no-reply@playndgain.com
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# The mailbox a person reads: invoices, mail footers, the publisher banner, and
# every message the public contact form sends.
PLAYNDGAIN_SUPPORT_EMAIL=support@playndgain.com

# Where alerts go. Empty means ledger drift — money code writing a balance
# without the entry that justifies it — stays in the log and nobody is told.
PLAYNDGAIN_ALERT_EMAILS=

# --- Fraud engine IP intelligence ------------------------------------------
#
# Without these the databases are never fetched, every lookup returns unknown,
# and the geo / datacenter / proxy rules place nobody. Both are free tier.
# The weekly `geoip:update` runs in the scheduler container and writes into the
# playndgain-storage volume, which all three containers share.

MAXMIND_LICENSE_KEY=
IP2LOCATION_DOWNLOAD_TOKEN=

# --- Backups ---------------------------------------------------------------
#
# The default `local` disk writes into the shared volume, which survives a bad
# migration and nothing else. Set this to an off-site S3-compatible disk before
# you have anything worth restoring, and fill in the AWS_* block below.
# The archive includes the environment, so a restore needs APP_KEY too.

# BACKUP_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Optional --------------------------------------------------------------

# Footer social links. Each renders only when set.
# PLAYNDGAIN_SOCIAL_X=
# PLAYNDGAIN_SOCIAL_LINKEDIN=
# PLAYNDGAIN_SOCIAL_DISCORD=
# PLAYNDGAIN_SOCIAL_INSTAGRAM=

# Credit-note issuer. Blank fields stay blank on the PDF.
# INVOICE_COMPANY_NAME="${APP_NAME}"
# INVOICE_ADDRESS=
# INVOICE_CITY=
# INVOICE_COUNTRY=
# INVOICE_VAT=
# INVOICE_VAT_RATE=0
