# Public identity. Changing these updates the site, panels, mail chrome,
# invoice PDFs and support links. Admin → Settings can override name / mail /
# invoice fields without a deploy; blank settings mean "use this file".
APP_NAME=PLAYNDGAIN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production is MySQL 9.7 LTS. Local dev on MariaDB is fine — see docs/11-infrastructure.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=playndgain
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: Mailpit on :1025.
# Production options:
#   MAIL_MAILER=mailgun  (+ MAILGUN_* keys), or
#   MAIL_MAILER=hostinger (+ HOSTINGER_MAIL_* keys — Mail API, not SMTP).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@playndgain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun HTTP API. Domain must be verified; from-address must be on that domain.
# EU region: MAILGUN_ENDPOINT=api.eu.mailgun.net
# MAILGUN_DOMAIN=mg.playndgain.com
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.mailgun.net

# Hostinger Mail API. Token from Agentic Mail → API access; mailbox ID from GET /api/v1/me.
# From-address should be the mailbox address that mailbox ID belongs to.
# HOSTINGER_MAIL_API_TOKEN=
# HOSTINGER_MAIL_MAILBOX_ID=
# HOSTINGER_MAIL_BASE_URL=https://api.mail.hostinger.com

# The mailbox a person reads: invoices, mail footers, the publisher banner, and
# every message the public contact form sends. Set it — the fallback is
# MAIL_FROM_ADDRESS, which is the no-reply nobody opens.
PLAYNDGAIN_SUPPORT_EMAIL=support@playndgain.com

# Credit-note issuer. Blank fields stay blank on the PDF. Defaults follow APP_NAME / APP_URL / support mail.
# INVOICE_COMPANY_NAME="${APP_NAME}"
# INVOICE_ADDRESS=
# INVOICE_CITY=
# INVOICE_COUNTRY=
# INVOICE_VAT=
# INVOICE_WEBSITE="${APP_URL}"
# INVOICE_EMAIL="${PLAYNDGAIN_SUPPORT_EMAIL}"
# INVOICE_DIRECTORS=
# INVOICE_VAT_RATE=0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Defaults to true. Set false ONLY for local development — the admin panel moves
# money and bans accounts.
# PLAYNDGAIN_REQUIRE_ADMIN_2FA=false

# Fraud engine IP intelligence — `php artisan geoip:update`, weekly.
# Without these the databases are never fetched, every lookup returns unknown,
# and the geo/datacenter/proxy rules place nobody. Both are free tier.
#   MaxMind      → maxmind.com/en/geolite2/signup, then Manage License Keys
#   IP2Location  → lite.ip2location.com, then File Download → Download Token
MAXMIND_LICENSE_KEY=
IP2LOCATION_DOWNLOAD_TOKEN=
# Defaults to storage/app/geoip. Point elsewhere if the databases live on a
# volume shared between web and queue hosts.
# PLAYNDGAIN_GEOIP_PATH=/var/lib/playndgain/geoip

# LOCAL DEVELOPMENT ONLY, and only read while APP_ENV=local.
# Nothing places 127.0.0.1, and the wall fails closed on an address it cannot
# place — so without this your local wall is permanently empty. Set it to a
# country your seeded inventory targets and private/reserved addresses resolve
# there; public addresses still go through the real databases.
# PLAYNDGAIN_DEV_COUNTRY=EG

# Wall rate limits — docs/03-offerwall.md §6. Production defaults are 60/min per
# IP and 600/min per app. Raise in local/staging when load-testing or when icon
# fetches burn the per-IP budget during development.
# PLAYNDGAIN_LIMIT_WALL_IP=600
# PLAYNDGAIN_LIMIT_WALL_APP=6000

# Where alerts go — docs/11 §7. Comma-separated. Empty means every alert stays
# in the log and nobody is told, including ledger drift, which the spec rates as
# a page: money code wrote a balance without the entry that justifies it.
PLAYNDGAIN_ALERT_EMAILS=
# One email per alert key per window, so drift across 400 publishers is one
# email rather than 400. Zero disables the cooldown.
# PLAYNDGAIN_ALERT_COOLDOWN_MINUTES=60

# Where nightly backups go — docs/11 §6. Defaults to the local disk, which
# survives a bad migration and nothing else: set this to an off-site S3 or B2
# disk from config/filesystems.php in production. The backup includes `.env`,
# and a database restored without the key that decrypts network credentials and
# app secrets is a database of unreadable ciphertext.
# BACKUP_DISK=s3

# Footer social links. Each renders only when set.
# PLAYNDGAIN_SOCIAL_X=https://x.com/playndgain
# PLAYNDGAIN_SOCIAL_LINKEDIN=
# PLAYNDGAIN_SOCIAL_DISCORD=
# PLAYNDGAIN_SOCIAL_INSTAGRAM=

VITE_APP_NAME="${APP_NAME}"
