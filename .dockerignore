# Build context for the container image (docs/13-dokploy.md).
#
# Everything the image needs is either in the repository or produced by a build
# stage. Everything below is either rebuilt inside the image (vendor, node
# modules, the Vite output), host-only state (.env, caches, screenshots), or
# large enough to make the context slow to ship to the daemon.

.git
.gitattributes
.github

# Editor / tooling state
.idea
.vscode
.cursor
.zed
.fleet
.nova
.phpactor.json
.playwright-mcp
**/.DS_Store

# Rebuilt by the `vendor` and `assets` stages. Copying the host's copies in
# would ship a macOS-built tree into an Alpine image.
node_modules
vendor
public/build
public/flags
public/hot
public/storage
public/css/filament
public/js/filament
public/fonts/filament

# Host state. `.env` above all: the image must carry no environment file at
# all, or Dokploy's variables would sit behind a baked-in APP_DEBUG=true.
.env
.env.backup
.env.production
storage/app/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
storage/pail
storage/*.key
.phpunit.cache
.phpunit.result.cache

# Not part of a release
tests
shots
/*.png
lighthouserc.json
phpstan.neon
phpunit.xml
pint.json
