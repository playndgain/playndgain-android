# ${WALL_DOMAIN} — the offerwall, and nothing else.
#
# The container copy of deploy/nginx/wall.playndgain.com.conf. Read that file
# first: it carries the reasoning, and it is the copy
# tests/Feature/Security/SecurityChecklistTest.php asserts against.
#
# THE HEADER RULE ON THIS DOMAIN IS LOAD-BEARING, and it survives the move into
# a container unchanged. The wall is an iframe on arbitrary publisher domains.
# `X-Frame-Options: DENY` or a `frame-ancestors` policy applied here breaks
# every integration we have, at once, silently — the publisher sees a blank
# frame and we see a normal 200 in the access log. That is why this file does
# NOT include playndgain-security-headers.conf, why the header is cleared
# explicitly rather than merely left unset, and why the `fastcgi_hide_header`
# below is not decoration.
#
# It is also why the site block, not this one, is `default_server`: a request
# arriving on a name nobody configured must not inherit the one policy in this
# image that deliberately turns framing protection off.
#
# No HSTS here either (docs/11 §10: panels only). HSTS on this name would be
# inherited by every publisher's embed context and is not ours to set — and
# under Dokploy the header would come from Traefik's middleware, so leave that
# middleware off this domain too.

server {
    listen 80;
    listen [::]:80;

    server_name ${WALL_DOMAIN};
    root /var/www/html/public;
    index index.php;

    charset utf-8;

    # Zone declared in conf.d/playndgain-limit-zones.conf, copied into this
    # image from deploy/. Burst 20 with `nodelay` so a wall that fires its icon
    # requests in parallel is not throttled for looking like exactly what it is.
    #
    # This limit is per client IP only because the http block resolves the real
    # one out of X-Forwarded-For. Behind Traefik without that, the key would be
    # the proxy and this line would throttle the whole product to 60r/m.
    limit_req zone=wall burst=20 nodelay;
    limit_req_status 429;

    add_header X-Frame-Options "" always;
    add_header Content-Security-Policy "frame-ancestors *;" always;

    # Same compression as the site: the wall bundle is a stylesheet and a
    # script too, loaded on someone else's page over someone else's network.
    # The snippet holds gzip directives and nothing else — an `add_header` in
    # it would land on this domain as well.
    include /etc/nginx/snippets/playndgain-gzip.conf;

    location / {
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass php-fpm;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;

        # The line that makes the promise above true. `add_header
        # X-Frame-Options ""` only stops *nginx* adding the header — it cannot
        # remove one PHP emitted. If a hardening middleware ever lands in the
        # application, this drops it on the way out for this domain only.
        fastcgi_hide_header X-Frame-Options;

        # Repeated for the same reason they are repeated in the site block:
        # `add_header` in a location discards the inherited set. Dropping them
        # here would un-embed every wall render, which is the only response on
        # this domain that matters.
        add_header X-Frame-Options "" always;
        add_header Content-Security-Policy "frame-ancestors *;" always;
    }

    location ^~ /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "" always;
        add_header Content-Security-Policy "frame-ancestors *;" always;
    }

    location ~* \.(woff2|avif|webp|png|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "" always;
        add_header Content-Security-Policy "frame-ancestors *;" always;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
