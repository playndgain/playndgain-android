# ${API_DOMAIN} — inbound network postbacks, and nothing else.
#
# The container copy of deploy/nginx/api.playndgain.com.conf; that file carries
# the reasoning. Same four container differences as the site block: rendered
# server_name, /var/www/html/public, the loopback PHP pool, container logs.

server {
    listen 80;
    listen [::]:80;

    server_name ${API_DOMAIN};
    root /var/www/html/public;
    index index.php;

    # Zone in conf.d/playndgain-limit-zones.conf. Deliberately far looser than
    # the wall: a network clearing its retry backlog after an outage is a
    # legitimate burst of conversions we are owed money for, and shedding it
    # costs real revenue. `nodelay` because a queued postback is a postback the
    # network times out and retries anyway.
    limit_req zone=api burst=200 nodelay;
    limit_req_status 429;

    # Postbacks are query strings and small form posts. Anything larger is not
    # a postback.
    client_max_body_size 128k;

    include /etc/nginx/snippets/playndgain-security-headers.conf;

    # This domain exposes exactly one route. Everything else is a 404 before it
    # reaches PHP — the panels and the wall are not reachable through this name
    # even if a future route file starts answering on it.
    location / {
        return 404;
    }

    location ^~ /postback/ {
        try_files $uri /index.php?$query_string;
    }

    # Laravel's built-in health endpoint, so an external HTTP check can watch
    # this domain without going through a money route (docs/11 §7).
    location = /up {
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass php-fpm;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include /etc/nginx/snippets/playndgain-security-headers.conf;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
